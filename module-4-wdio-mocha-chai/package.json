{
  "name": "task-wdio-mocha-chai",
  "type": "module",
  "devDependencies": {
    "@wdio/cli": "^9.28.0",
    "@wdio/local-runner": "^9.28.0",
    "@wdio/mocha-framework": "^9.28.0",
    "@wdio/spec-reporter": "^9.29.1",
    "chai": "^6.2.2",
    "wdio-html-nice-reporter": "^8.1.7"
  },
  "scripts": {
  "test": "wdio run ./wdio.conf.js",
