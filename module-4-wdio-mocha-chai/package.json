{
    "name": "task-wdio-mocha-chai",
    "type": "module",
    "devDependencies": {
        "@wdio/cli": "^8.46.0",
        "@wdio/local-runner": "^8.46.0",
        "@wdio/mocha-framework": "^8.46.0",
        "@wdio/spec-reporter": "^8.43.0",
        "chai": "^6.2.2",
        "wdio-html-nice-reporter": "^8.1.7",
        "webdriverio": "^8.46.0"
    },
    "scripts": {
        "test": "wdio run ./wdio.conf.js",
